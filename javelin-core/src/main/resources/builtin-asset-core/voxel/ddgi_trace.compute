#version 450

// DDGI 追踪段（Engine_DDGI_Design §4.1，P4-05 批 B2；直射项修正 2026-11-22）
// 一 workgroup = 一个探针；64 线程 = 八面体 8×8 = 64 条方向，每条走一次体素 DDA。
// 输出：临时 radiance tile（rgba16f，内区 8×8，A 未用）+ 距离 tile（rg16f，R = 命中距离）。
// 命中着色 = albedo × (ambient? + 主光 × ndl × CSM 阴影因子)；未命中 = 环境色（不接天空盒）。
// 直射项遮挡走 CSM 阴影图（与主画面同一张图、同一套矩阵——两套影子系统边界不一致
// 会在阴影区渗「体素级假直射」；原体素 DDA sunVisible 过渡件已退役）。

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler3D voxels;

layout(set = 0, binding = 1) uniform VoxelParams {
    vec4 originResolution; // xyz = 体素网格原点，w = 单边体素数
    vec4 voxelSize;        // xyz = 单体素边长
    vec4 gridBounds;       // xyz = 网格上界
    vec4 reserved;
} field;

layout(set = 0, binding = 2, rgba16f) uniform image2D radianceOut;
layout(set = 0, binding = 3, rg16f) uniform image2D distanceOut;

layout(set = 0, binding = 4) uniform ProbeGrid {
    vec4 originSpacing;    // xyz = 网格原点，w = spacing
    ivec4 counts;          // xyz = 三向探针数，w = tilesPerRow
    vec4 tileParams;       // x = 辐照度 tile 边长(10)，y = 深度 tile 边长(18)，z/w 内区边长(8/16)
    vec4 reservedGrid;     // y = maxDistance（诊断段未命中判定用）
} grid;

layout(set = 0, binding = 5) uniform Lighting {
    vec4 sunDir;           // xyz = 指向光源的方向（已归一），w 未用
    vec4 sunColor;         // rgb = 颜色 × 强度
    vec4 ambient;          // rgb = 环境色，w = 强度
    vec4 lightingFlags;    // x = 命中辐射是否含 ambient 项（1 = 消费面未接管/非 DDGI 档，
                           //      保留 ambient 进辐射保诊断可读；DDGI 档 = 0，常量环境项
                           //      已由消费面负责，探针里再弹一次等于假环境光翻倍）
} light;

// 主光 CSM 阴影（set1 LightingParamsBlock 的 CSM 段同布局拷贝——compute 不直接绑
// set1 的 dynamic UBO，宿主单独打包一份；数据源=主视口 ViewShadow）
layout(set = 0, binding = 6) uniform sampler2DShadow sunShadowMap;
layout(set = 0, binding = 7) uniform ShadowParams {
    vec4 cascadeHead;      // x = 级联数（0 = 无阴影，恒受光），yzw 预留
    mat4 sunViewProj[4];   // 逐级联 世界→光裁剪（未用槽 identity）
    vec4 cascadeSplits;    // 逐级联视空间 z 远界（探针侧不用，保留对齐）
    vec4 shadowParams;     // x = 品质档 / y = PCF 半径 / z = 强度 / w = refDepthOffset（世界单位）
    vec4 shadowParams2;    // x = atlas 每轴象限数 / y = atlas 边长 / zw 预留
    vec4 cascadeInvZ;      // 逐级联 1/光空间 z 范围（refDepthOffset 折算除数）
} shadow;

layout(push_constant) uniform Push {
    uint sliceStart;       // 本帧首个探针的线性索引
    uint probeCount;       // 本帧派发探针数
    uint tilesPerRow;
    float maxDistance;     // 单条射线最长距离（世界单位）
} pc;

const float OCT_EPS = 1e-6;

// 八面体解码：uv ∈ [0,1]² → 单位方向
vec3 octDecode(vec2 uv) {
    vec2 o = uv * 2.0 - 1.0;
    vec3 n = vec3(o.x, o.y, 1.0 - abs(o.x) - abs(o.y));
    if (n.z < 0.0) {
        // 八面体标准式：必须同时用「未改写的 n.yx」算模长（先改 n.x 再用它算 n.y 会把
        // 下半球方向整体扭歪，与消费端 javelinOctaEncode 就对不上了）
        n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(n);
}

bool insideGrid(ivec3 c, int res) {
    return c.x >= 0 && c.y >= 0 && c.z >= 0 && c.x < res && c.y < res && c.z < res;
}

// Amanatides & Woo 体素 DDA：返回命中距离（<0 = 未命中），出参为命中体素基色与面法线估算
float traceVoxel(vec3 ro, vec3 rd, out vec3 hitAlbedo, out vec3 hitNormal) {
    hitAlbedo = vec3(0.0);
    hitNormal = -rd;
    int res = int(field.originResolution.w);
    if (res <= 0) {
        return -1.0;
    }
    vec3 org = field.originResolution.xyz;
    vec3 vs = field.voxelSize.xyz;

    vec3 inv = 1.0 / vs;
    ivec3 cell = ivec3(floor((ro - org) * inv));
    ivec3 stp = ivec3(rd.x >= 0.0 ? 1 : -1, rd.y >= 0.0 ? 1 : -1, rd.z >= 0.0 ? 1 : -1);

    vec3 tDelta = vec3(1e30);
    vec3 tMax = vec3(1e30);
    for (int a = 0; a < 3; a++) {
        float d = rd[a];
        if (abs(d) < OCT_EPS) {
            continue;                    // 该轴不跨格：tMax/tDelta 保持 1e30
        }
        float bound = org[a] + vs[a] * float(cell[a] + (stp[a] > 0 ? 1 : 0));
        tMax[a] = (bound - ro[a]) / d;
        tDelta[a] = abs(vs[a] / d);
    }

    float t = 0.0;
    for (int guard = 0; guard < 1024; guard++) {
        if (!insideGrid(cell, res)) {
            return -1.0;                 // 出网格 = 未命中（回落环境色）
        }
        vec4 texel = texelFetch(voxels, cell, 0);
        if (texel.a > 0.5) {
            hitAlbedo = texel.rgb;
            int axis = tMax.x < tMax.y ? (tMax.x < tMax.z ? 0 : 2) : (tMax.y < tMax.z ? 1 : 2);
            vec3 n = vec3(0.0);
            n[axis] = -float(stp[axis]);  // 进入面的法线朝回来方向
            hitNormal = n;
            return t;
        }
        int axis = tMax.x < tMax.y ? (tMax.x < tMax.z ? 0 : 2) : (tMax.y < tMax.z ? 1 : 2);
        t = tMax[axis];
        if (t > pc.maxDistance) {
            return -1.0;
        }
        cell[axis] += stp[axis];
        tMax[axis] += tDelta[axis];
    }
    return -1.0;
}

// 主光直射的 CSM 阴影因子（移植自 ShaderInjector javelinCascadeShadow，单 tap 降档版）。
// 级联选择用「逐级联试投影」而非主路径的视 z 选择：探针射线命中点散布全场、不经主相机
// 视锥，按视 z 选没有意义；第一个把命中点投进 [-1,1]³ 的级联即覆盖盒命中。全出界 = 盒外
// 恒受光（1.0）——与主路径「超出末级联恒受光」同语义。
// PCF 降档理由：探针是低频数据（时域 hysteresis + 消费面三线性已经两级平滑），单 tap 的
// 锯齿不会直接上屏；省下 compute 里每命中点 4~9 tap 的采样预算。
float cascadeShadowFactor(vec3 worldPos) {
    int cascadeCount = int(shadow.cascadeHead.x);
    if (cascadeCount <= 0) {
        return 1.0;   // 无阴影资源（主光无 castShadow / 无主相机）：恒受光
    }
    float grid = shadow.shadowParams2.x;
    float atlasSize = shadow.shadowParams2.y;
    float quad = 1.0 / grid;
    for (int c = 0; c < cascadeCount; c++) {
        vec3 proj = (shadow.sunViewProj[c] * vec4(worldPos, 1.0)).xyz;
        if (proj.x < -1.0 || proj.x > 1.0 || proj.y < -1.0 || proj.y > 1.0
                || proj.z < 0.0 || proj.z > 1.0) {
            continue;   // 该级联不覆盖此命中点：试下一级
        }
        int col = c - (c / int(grid)) * int(grid);
        int row = c / int(grid);
        vec2 quadOrigin = vec2(float(col), float(row)) * quad;
        vec2 uv = quadOrigin + (proj.xy * 0.5 + 0.5) * quad;
        // refZ 补偿与主路径同源：refDepthOffset（世界单位）× cascadeInvZ + 半纹素外扩
        //（接触漏光修复口径，Engine_Shadow_Quality_Design §9.6）
        float cascadeTexels = atlasSize / grid;
        float refZ = proj.z + shadow.shadowParams.w * shadow.cascadeInvZ[c]
                + 0.5 / cascadeTexels;
        return texture(sunShadowMap, vec3(uv, refZ));
    }
    return 1.0;
}

void main() {
    uint probe = pc.sliceStart + gl_WorkGroupID.x;
    uint total = uint(grid.counts.x * grid.counts.y * grid.counts.z);
    if (probe >= total) {
        return;
    }

    // 线性索引 → 网格坐标 → 探针世界位置
    uint xyPlane = uint(grid.counts.x * grid.counts.y);
    uint pz = probe / xyPlane;
    uint rem = probe - pz * xyPlane;
    uint py = rem / uint(grid.counts.x);
    uint px = rem - py * uint(grid.counts.x);
    vec3 probePos = grid.originSpacing.xyz
            + vec3(float(px), float(py), float(pz)) * grid.originSpacing.w;

    // 八面体方向（内区 8×8）
    vec2 uv = (vec2(gl_LocalInvocationID.xy) + 0.5) / vec2(float(grid.tileParams.z));
    vec3 dir = octDecode(uv);

    vec3 albedo;
    vec3 normal;
    float dist = traceVoxel(probePos, dir, albedo, normal);
    vec3 radiance;
    if (dist < 0.0) {
        // 未命中：环境色兜底（不接天空盒）
        radiance = light.ambient.rgb * light.ambient.a;
        dist = pc.maxDistance;
    } else {
        float ndl = max(dot(normal, light.sunDir.xyz), 0.0);
        // 直射项遮挡 = CSM 阴影图（与主画面同一张图；体素级判不出的遮挡不再渗假直射）
        float sunShadow = 1.0;
        if (ndl > 0.0 && (light.sunColor.r + light.sunColor.g + light.sunColor.b) > 0.0) {
            sunShadow = cascadeShadowFactor(probePos + dir * dist);
        }
        // ambient 门控：DDGI 档下消费面已接管环境项，探针里再弹常量 ambient 等于假环境光
        // 弹两次（§13.6 遗留第 2 条）；非接管档保留，否则探针全黑、诊断读数失真
        vec3 ambientTerm = light.lightingFlags.x > 0.5
                ? light.ambient.rgb * light.ambient.a : vec3(0.0);
        radiance = albedo * (ambientTerm + light.sunColor.rgb * ndl * sunShadow);
    }

    // 写入本探针 tile 的内区（1px 边框留给后续接缝处理，B2 不填）
    int tileSide = int(grid.tileParams.x);
    int tileCol = int(probe % pc.tilesPerRow);
    int tileRow = int(probe / pc.tilesPerRow);
    ivec2 px2 = ivec2(tileCol * tileSide + 1, tileRow * tileSide + 1)
            + ivec2(gl_LocalInvocationID.xy);
    imageStore(radianceOut, px2, vec4(radiance, 1.0));
    imageStore(distanceOut, px2, vec4(dist, 0.0, 0.0, 0.0));
}
