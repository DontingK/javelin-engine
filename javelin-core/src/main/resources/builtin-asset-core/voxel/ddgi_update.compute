#version 450

// DDGI 更新段（Engine_DDGI_Design §4.2，P4-05 批 B2）
// 一 workgroup = 一个探针；64 线程分工：
//   线程 (i,j) 写辐照度内区 texel (i,j)（8×8）——按余弦权重把 8×8 条射线的 radiance 积起来；
//   同一线程再摊 4 个深度 texel（16×16 = 64×4）——把同一批射线的距离积成 E(d) / E(d²)。
// 时域混合：与 atlas 里已有值按 hysteresis 混（首圈由宿主把 hysteresis 传 0，避免从黑往上爬）。

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D radianceIn;
layout(set = 0, binding = 1) uniform sampler2D distanceIn;

layout(set = 0, binding = 2, rgba16f) uniform image2D irradianceOut;
layout(set = 0, binding = 3, rg16f) uniform image2D depthOut;

layout(set = 0, binding = 4) uniform ProbeGrid {
    vec4 originSpacing;    // xyz = 网格原点，w = spacing
    ivec4 counts;          // xyz = 三向探针数，w = tilesPerRow
    vec4 tileParams;       // x = 辐照度 tile 边长(10)，y = 深度 tile 边长(18)，z/w 内区边长(8/16)
    vec4 reservedGrid;
} grid;

// 诊断通道（B2 验收用）：前 8 个探针写 4 个 float = 内区 texel(0,0) 的辐照度 rgb + 深度 texel(0,0) 的均值
layout(set = 0, binding = 5, std430) buffer DebugOut {
    float samples[];
} debugOut;

layout(push_constant) uniform Push {
    uint sliceStart;
    uint probeCount;
    uint tilesPerRow;
    float hysteresis;      // 0 = 完全用本帧结果（首圈），0.85 = 历史占八成五
} pc;

// 八面体解码（与 trace 段同一口径，必须逐字一致否则方向对不上）
vec3 octDecode(vec2 uv) {
    vec2 o = uv * 2.0 - 1.0;
    vec3 n = vec3(o.x, o.y, 1.0 - abs(o.x) - abs(o.y));
    if (n.z < 0.0) {
        n.x = (1.0 - abs(n.y)) * (n.x >= 0.0 ? 1.0 : -1.0);
        n.y = (1.0 - abs(n.x)) * (n.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(n);
}

void main() {
    uint probe = pc.sliceStart + gl_WorkGroupID.x;
    uint total = uint(grid.counts.x * grid.counts.y * grid.counts.z);
    if (probe >= total) {
        return;
    }

    int irrTile = int(grid.tileParams.x);
    int depTile = int(grid.tileParams.y);
    int irrInner = int(grid.tileParams.z);
    int depInner = int(grid.tileParams.w);
    int tileCol = int(probe % pc.tilesPerRow);
    int tileRow = int(probe / pc.tilesPerRow);

    // 诊断槽：取「网格中心 2×2×2」块（角探针多半落在体素场外，只会在日志里刷出一排环境色）
    int dbgSlot = -1;
    {
        ivec3 dcenter = ivec3(grid.counts.xyz) / 2;
        ivec3 p = ivec3(int(probe % uint(grid.counts.x)),
                        int((probe / uint(grid.counts.x)) % uint(grid.counts.y)),
                        int(probe / uint(grid.counts.x * grid.counts.y)));
        ivec3 off = p - dcenter;
        if (off.x >= 0 && off.x < 2 && off.y >= 0 && off.y < 2 && off.z >= 0 && off.z < 2) {
            dbgSlot = off.x + off.y * 2 + off.z * 4;
        }
    }

    // 射线方向表：radiance tile 内区 8×8
    ivec2 irrBase = ivec2(tileCol * irrTile + 1, tileRow * irrTile + 1);
    ivec2 rayBase = irrBase;   // radiance tile 与辐照度 tile 同版面

    // ── ① 辐照度：线程 (i,j) 一个 texel ──
    // gl_LocalInvocationID 是 uvec3，不能隐式转 ivec2（shaderc 在隐式缩窄上直接报错）
    ivec2 ij = ivec2(gl_LocalInvocationID.xy);
    vec3 nrm = octDecode((vec2(ij) + 0.5) / vec2(float(irrInner)));
    float wSum = 0.0;
    vec3 acc = vec3(0.0);
    for (int y = 0; y < irrInner; y++) {
        for (int x = 0; x < irrInner; x++) {
            vec3 rayDir = octDecode((vec2(x, y) + 0.5) / vec2(float(irrInner)));
            float w = max(dot(rayDir, nrm), 0.0);
            if (w <= 0.0) {
                continue;
            }
            vec3 radiance = texelFetch(radianceIn, rayBase + ivec2(x, y), 0).rgb;
            acc += radiance * w;
            wSum += w;
        }
    }
    vec3 irradiance = wSum > 0.0 ? acc / wSum : vec3(0.0);
    // 广度与余弦加权分摊：把 wSum 归一后乘 π 近似（与消费面口径一致，避免整体偏暗）
    irradiance *= 3.14159265;

    ivec2 irrCoord = irrBase + ij;
    // 注意：atlas 首圈内容未定义（未上传零值），hysteresis=0 时不能去 imageLoad 再 mix——
    // 未定义值可能是 NaN，NaN×0 仍是 NaN，会把整片辐照度污染成 NaN。首圈直接取本帧结果。
    vec3 prevIrr = vec3(0.0);
    if (pc.hysteresis > 0.0) {
        prevIrr = imageLoad(irradianceOut, irrCoord).rgb;
    }
    vec3 blended = mix(irradiance, prevIrr, pc.hysteresis);
    imageStore(irradianceOut, irrCoord, vec4(blended, 1.0));

    // 诊断：中心块 8 探针由线程 (0,0) 把本帧混合后的辐照度写进宿主可读的 SSBO
    if (dbgSlot >= 0 && ij.x == 0 && ij.y == 0) {
        int dbg = dbgSlot * 4;
        debugOut.samples[dbg + 0] = blended.r;
        debugOut.samples[dbg + 1] = blended.g;
        debugOut.samples[dbg + 2] = blended.b;
    }

    // ── ② 深度矩：本线程摊 4 个 texel（16×16 = 64 × 4）──
    int k = int(ij.y) * irrInner + int(ij.x);   // 线程线性号 0..63
    for (int m = 0; m < 4; m++) {
        int dIdx = k * 4 + m;                    // 深度 texel 线性号 0..255
        if (dIdx >= depInner * depInner) {
            break;
        }
        ivec2 dxy = ivec2(dIdx % depInner, dIdx / depInner);
        vec3 dDir = octDecode((vec2(dxy) + 0.5) / vec2(float(depInner)));
        float dw = 0.0;
        float m1 = 0.0;
        float m2 = 0.0;
        for (int y = 0; y < irrInner; y++) {
            for (int x = 0; x < irrInner; x++) {
                vec3 rayDir = octDecode((vec2(x, y) + 0.5) / vec2(float(irrInner)));
                float w = max(dot(rayDir, dDir), 0.0);
                if (w <= 0.0) {
                    continue;
                }
                float d = texelFetch(distanceIn, rayBase + ivec2(x, y), 0).r;
                dw += w;
                m1 += d * w;
                m2 += d * d * w;
            }
        }
        float meanD = dw > 0.0 ? m1 / dw : 0.0;
        float meanD2 = dw > 0.0 ? m2 / dw : 0.0;
        ivec2 dCoord = ivec2(tileCol * depTile + 1, tileRow * depTile + 1) + dxy;
        vec2 prevD = vec2(0.0);
        if (pc.hysteresis > 0.0) {
            prevD = imageLoad(depthOut, dCoord).rg;   // 同辐照度：首圈不读未定义内容
        }
        vec2 blended2 = mix(vec2(meanD, meanD2), prevD, pc.hysteresis);
        imageStore(depthOut, dCoord, vec4(blended2, 0.0, 0.0));

        if (dIdx == 0 && dbgSlot >= 0) {
            debugOut.samples[dbgSlot * 4 + 3] = blended2.x;
        }
    }
}
