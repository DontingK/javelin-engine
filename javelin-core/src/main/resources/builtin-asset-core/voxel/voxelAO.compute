#version 450

// 体素 AO 求值（Engine_VoxelAO_Design §4，批 C）
// 一 invocation = 一个 AO 体素：以该体素中心为原点均匀撒 rayCount 条球面射线，
// 半体素步长在占用图上步进求最近命中距离，按「命中距离 / 最大距离」加权累加可见度。
// 输出 R8_UNORM 3D 纹理（1.0 = 完全开阔，0.0 = 完全遮蔽），运行期三线性采样乘环境项。
//
// 首版取舍：不做法线半球（球面 + 距离加权，避法线估计噪声与常数偏移），
// 采样侧需沿表面法线偏半个体素再取值（见设计档 §5）。

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) uniform usampler3D occupancy;
layout(set = 0, binding = 1, r8) uniform image3D aoOut;

layout(set = 0, binding = 2) uniform VoxelParams {
    vec4 originResolution; // xyz = 网格原点（世界），w = 占用分辨率
    vec4 voxelSize;        // xyz = 占用体素边长，w = AO 分辨率
    vec4 aoParams;         // x = 射线数, y = 最大距离, z = 强度（本 kernel 不用）, w = 启用位
    vec4 gridBounds;       // xyz = 网格上界
} voxel;

uint hashU(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

/** 按体素坐标抖动的随机数（同体素同种子，逐帧稳定，无闪噪） */
float randf(inout uint s) {
    s = hashU(s);
    return float(s & 0xFFFFFFu) / 16777216.0;
}

/** 世界点是否落在已占用体素内（越界按空处理） */
bool occupied(vec3 p, int res) {
    vec3 g = (p - voxel.originResolution.xyz) / voxel.voxelSize.xyz;
    ivec3 c = ivec3(floor(g));
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(res)))) {
        return false;
    }
    return texelFetch(occupancy, c, 0).r != 0u;
}

void main() {
    int aoRes = int(voxel.voxelSize.w);
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, ivec3(aoRes)))) {
        return;
    }
    int occRes = int(voxel.originResolution.w);
    if (occRes <= 0 || aoRes <= 0) {
        imageStore(aoOut, id, vec4(1.0, 0.0, 0.0, 1.0));
        return;
    }
    int rays = max(1, int(voxel.aoParams.x));
    float maxDist = max(0.1, voxel.aoParams.y);

    float ratio = float(occRes) / float(aoRes);
    vec3 aoVox = voxel.voxelSize.xyz * ratio;
    vec3 p = voxel.originResolution.xyz + (vec3(id) + 0.5) * aoVox;

    float stepLen = 0.5 * min(voxel.voxelSize.x, min(voxel.voxelSize.y, voxel.voxelSize.z));
    int steps = clamp(int(ceil(maxDist / stepLen)), 1, 256);

    uint seed = hashU(uint(id.x) * 73856093u ^ uint(id.y) * 19349663u
            ^ uint(id.z) * 83492791u ^ 0x9E3779B9u);

    float vis = 0.0;
    // free-space bias 门控（2026-11-19 修「无效果」）：跳出段只对「中心本身落在
    // 膨胀实体内」的体素生效，且只跳固定厚度——体素化 kernel 的膨胀容差是
    // halfDiag（平面厚度 + 二维边距各半对角），自身壳最坏 ≈ 2×halfDiag = 体素对角线长。
    // 旧版 while「跳过整段连续实体」把贴邻的墙/桌板整个吞掉（steps 耗尽或从背面
    // 穿出 → 贡献 1.0），全场 AO ≈ 1.0，乘了等于没乘。
    bool selfInside = occupied(p, occRes);
    float selfSkip = length(voxel.voxelSize.xyz);
    int skipSteps = int(ceil(selfSkip / stepLen));
    for (int r = 0; r < rays; ++r) {
        float u1 = randf(seed);
        float u2 = randf(seed);
        // 均匀球面方向（z 均匀 + 方位角均匀）
        float z = u1 * 2.0 - 1.0;
        float rr = sqrt(max(0.0, 1.0 - z * z));
        float phi = u2 * 6.2831853;
        vec3 dir = vec3(rr * cos(phi), z, rr * sin(phi));

        float t = stepLen;
        int s = 0;
        if (selfInside) {
            // 中心在实体内：只跳自身壳厚度（朝内的射线跳完仍在实体 → 计命中 t≈壳厚，
            // 贡献趋 0——实心体素下半球的固有基线，末尾按解析基线归一）
            for (int i = 0; i < skipSteps && s < steps; ++i) {
                t += stepLen;
                ++s;
            }
        }
        bool hit = false;
        for (; s < steps; ++s) {
            if (occupied(p + dir * t, occRes)) {
                hit = true;
                break;
            }
            t += stepLen;
        }
        // 近距命中贡献趋 0（缝隙/夹角暗），远距命中趋 1（开阔）
        vis += hit ? clamp(t / maxDist, 0.0, 1.0) : 1.0;
    }
    // 单表面基线归一化（2026-11-19 修「无效果」第二轮）：消费侧采样点已沿法线偏到
    // 表面外 1 个 AO 体素（空体素），其背向半球被「脚下的表面自身」遮挡是开阔面的
    // 固有基线，不是 0.5——按解析式：无限平面在下方 d 处的距离加权球面可见度
    //   下半球 = r(1 + ln(1/r))，r = d / maxDist；基线 = (1 + 下半球) / 2
    // （r=0.08 → 基线 ≈ 0.64）。旧版 2× 是对着 while-bug 造成的 0.5 假基线标定的，
    // 正确可见度下把一切 ≥ 0.5 的体素（开阔面/墙角/多数遮蔽）全钳到 1.0 = 无效果。
    // 归一后：开阔面 = 1.0、墙角 ≈ 0.6、桌底/接触缝 ≈ 0.25。
    float off = min(voxel.voxelSize.x, min(voxel.voxelSize.y, voxel.voxelSize.z))
            * (float(occRes) / float(aoRes));
    float r = clamp(off / maxDist, 1e-4, 1.0);
    float baseline = 0.5 * (1.0 + r * (1.0 - log(r)));
    float ao = clamp(vis / float(rays) / baseline, 0.0, 1.0);
    imageStore(aoOut, id, vec4(ao, 0.0, 0.0, 1.0));
}
