#version 450

// 体素化占用（Engine_VoxelAO_Design §4，批 B）
// 一 invocation = 一个三角形（世界空间）→ 保守光栅写 r32ui 3D 占用图。
// 描述符布局由消费方（Voxelizer）自组织：set0 b0 顶点 / b1 索引 / b2 占用图 / b3 参数。

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Vertices { float v[]; } verts;
layout(set = 0, binding = 1) readonly buffer Indices { uint i[]; } inds;
layout(set = 0, binding = 2, r32ui) uniform uimage3D occupancy;

layout(set = 0, binding = 3) uniform VoxelParams {
    vec4 originResolution; // xyz = 网格原点（世界），w = 占用分辨率
    vec4 voxelSize;        // xyz = 单体素边长，w = AO 分辨率（本 kernel 不用）
    vec4 aoParams;         // x = 射线数, y = 最大距离, z = 强度, w = 启用位
    vec4 gridBounds;       // xyz = 网格上界（origin + res*voxelSize）
} voxel;

layout(push_constant) uniform Push {
    mat4 world;            // 物体 → 世界
    uint indexBase;        // 本网格第一条索引（所有子网格区间从 0 起拼）
    uint triangleCount;
    uint strideFloats;     // 顶点步长（float 计）
    uint posOffsetFloats;  // POSITION 在步长内的偏移（float 计）
    uint indexU16;         // 1 = UINT16 索引（按 uint 字半字取）
} pc;

vec3 positionOf(uint index) {
    uint base = index * pc.strideFloats + pc.posOffsetFloats;
    return vec3(verts.v[base], verts.v[base + 1u], verts.v[base + 2u]);
}

uint indexAt(uint i) {
    if (pc.indexU16 != 0u) {
        // UINT16 缓冲按 uint 字读：低 16 位 = 偶数索引，高 16 位 = 奇数索引
        uint w = inds.i[i >> 1u];
        return (i & 1u) == 0u ? (w & 0xFFFFu) : (w >> 16u);
    }
    return inds.i[i];
}

vec2 project(vec3 p, int axis) {
    if (axis == 0) {
        return p.yz;
    }
    if (axis == 1) {
        return p.xz;
    }
    return p.xy;
}

// 点到边 ab 的有符号距离（除以边长归一，正值分布与三角形绕序一致）
float edgeDistance(vec2 p, vec2 a, vec2 b) {
    vec2 e = b - a;
    float len = max(length(e), 1e-6);
    return ((p.x - b.x) * (a.y - b.y) - (a.x - b.x) * (p.y - b.y)) / len;
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= pc.triangleCount) {
        return;
    }
    int res = int(voxel.originResolution.w);
    if (res <= 0) {
        return;
    }

    uint i0 = pc.indexBase + t * 3u;
    vec3 p0 = positionOf(indexAt(i0));
    vec3 p1 = positionOf(indexAt(i0 + 1u));
    vec3 p2 = positionOf(indexAt(i0 + 2u));
    vec3 w0 = (pc.world * vec4(p0, 1.0)).xyz;
    vec3 w1 = (pc.world * vec4(p1, 1.0)).xyz;
    vec3 w2 = (pc.world * vec4(p2, 1.0)).xyz;

    vec3 n = cross(w1 - w0, w2 - w0);
    float nlen = length(n);
    if (nlen < 1e-9) {
        return;
    }
    vec3 nrm = n / nlen;

    vec3 org = voxel.originResolution.xyz;
    vec3 vs = voxel.voxelSize.xyz;
    float halfDiag = 0.5 * length(vs);

    // 主轴：法线绝对值最大分量（保守投影平面）
    vec3 an = abs(nrm);
    int axis = an.x >= an.y ? (an.x >= an.z ? 0 : 2) : (an.y >= an.z ? 1 : 2);
    vec2 a2 = project(w0, axis);
    vec2 b2 = project(w1, axis);
    vec2 c2 = project(w2, axis);
    // 注意：`centroid` 是 GLSL 保留字（片元插值限定符），不能作变量名
    vec2 center2d = (a2 + b2 + c2) / 3.0;
    float s0 = sign(edgeDistance(center2d, a2, b2));
    float s1 = sign(edgeDistance(center2d, b2, c2));
    float s2 = sign(edgeDistance(center2d, c2, a2));

    vec3 mn = min(min(w0, w1), w2) - vec3(halfDiag);
    vec3 mx = max(max(w0, w1), w2) + vec3(halfDiag);
    ivec3 imin = clamp(ivec3(floor((mn - org) / vs)), ivec3(0), ivec3(res - 1));
    ivec3 imax = clamp(ivec3(floor((mx - org) / vs)), ivec3(0), ivec3(res - 1));

    for (int z = imin.z; z <= imax.z; ++z) {
        for (int y = imin.y; y <= imax.y; ++y) {
            for (int x = imin.x; x <= imax.x; ++x) {
                vec3 c = org + (vec3(x, y, z) + 0.5) * vs;
                // 平面厚度：体素中心落在三角平面半对角邻域内才算覆盖
                if (abs(dot(c - w0, nrm)) > halfDiag) {
                    continue;
                }
                // 保守二维包含：三条边有符号距离按绕序放大 halfDiag
                vec2 q = project(c, axis);
                float d0 = edgeDistance(q, a2, b2) * s0;
                float d1 = edgeDistance(q, b2, c2) * s1;
                float d2 = edgeDistance(q, c2, a2) * s2;
                if (d0 < -halfDiag || d1 < -halfDiag || d2 < -halfDiag) {
                    continue;
                }
                imageAtomicOr(occupancy, ivec3(x, y, z), 1u);
            }
        }
    }
}
