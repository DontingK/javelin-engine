<?xml version="1.0" encoding="UTF-8"?>
<!-- 日志级别从低到高分为TRACE < DEBUG < INFO < WARN < ERROR < FATAL，比如: 如果设置为WARN，则低于WARN的信息都不会输出 -->
<!-- scan:当此属性设置为true时，配置文档如果发生改变，将会被重新加载，默认值为true -->
<!-- scanPeriod:设置监测配置文档是否有修改的时间间隔，如果没有给出时间单位，默认单位是毫秒。当scan为true时，此属性生效。默认的时间间隔为1分钟。 -->
<!-- debug:当此属性设置为true时，将打印出logback内部日志信息，实时查看logback运行状态。默认值为false。 -->
<configuration scan="true" scanPeriod="10 seconds" debug="false">


    <!-- 日志文件大小上限（info/error 共用）：单文件超限即切下一份 %i -->
    <property name="log.max.size" value="20MB"/>
    <!-- 日志根目录：相对进程工作目录，即编辑器运行目录下的 logs/ -->
    <property name="log.base" value="logs"/>
    <!-- info 保留天数与总容量上限 -->
    <property name="log.info.max.history" value="10"/>
    <property name="log.info.total.size.cap" value="512MB"/>
    <!-- error 保留天数与总容量上限 -->
    <property name="log.error.max.history" value="30"/>
    <property name="log.error.total.size.cap" value="256MB"/>
    <!-- 定义日志输出格式-->
    <property name="log.pattern"
              value="%date{ISO8601} %-1level [%thread] %logger{56}.%method:%L -%msg%n"/>
    <property name="log.charset" value="UTF-8"/>

    <!--来自sptingboot 的彩色日志-->
    <conversionRule conversionWord="clr" converterClass="com.javelin.log.ColorConverter"/>
    <conversionRule conversionWord="wex" converterClass="com.javelin.log.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx"
                    converterClass="com.javelin.log.ExtendedWhitespaceThrowableProxyConverter"/>

    <property name="CONSOLE_LOG_PATTERN" value="${CONSOLE_LOG_PATTERN:-%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>
    <property name="CONSOLE_LOG_CHARSET" value="${CONSOLE_LOG_CHARSET:-${file.encoding:-UTF-8}}"/>
    <property name="FILE_LOG_PATTERN" value="${FILE_LOG_PATTERN:-%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}} ${LOG_LEVEL_PATTERN:-%5p} ${PID:- } --- [%t] %-40.40logger{39} : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>
    <property name="FILE_LOG_CHARSET" value="${FILE_LOG_CHARSET:-${file.encoding:-UTF-8}}"/>

    <!--控制台输出 -->
    <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
        <!-- 用来定义日志的格式 -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 全量日志文件输出：按天滚动 + 单文件大小封顶，内容=root 允许的全部级别（含 debug） -->
    <appender name="infoFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前活动日志文件（相对进程工作目录）。多进程同写此文件时滚动不互斥，本工程按单进程使用 -->
        <file>${log.base}/info/info.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 按天 + 按序回滚，历史文件 gzip 压缩 -->
            <fileNamePattern>${log.base}/info/info_%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- 日志最大存储天数 -->
            <maxHistory>${log.info.max.history}</maxHistory>
            <!-- 历史日志总容量上限，超出从最老旧文件开始删 -->
            <totalSizeCap>${log.info.total.size.cap}</totalSizeCap>
            <!-- 当天单文件超过 ${log.max.size} 时切分并压缩归档 -->
            <maxFileSize>${log.max.size}</maxFileSize>
        </rollingPolicy>
    </appender>

    <!-- 错误日志文件输出：只收 ERROR，便于排障速查 -->
    <appender name="errorFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.base}/error/error.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.base}/error/error_%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxHistory>${log.error.max.history}</maxHistory>
            <totalSizeCap>${log.error.total.size.cap}</totalSizeCap>
            <maxFileSize>${log.max.size}</maxFileSize>
        </rollingPolicy>
        <!-- 只保留 ERROR：非 ERROR 的日志事件到此为止 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <root level="debug">
        <appender-ref ref="stdout"/> <!-- 标识这个appender将会添加到这个logger -->
        <appender-ref ref="infoFile"/>
        <appender-ref ref="errorFile"/>
    </root>
    <logger name="ch.qos.logback" level="WARN" />
</configuration>
