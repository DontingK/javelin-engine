###########################################################################

#   Gradle start up script for POSIX generated by Grad

#   Important for runni

#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh
#       noncompliant, but you have some other compliant shell such as ksh
#       bash, then to run this script, type that shell name before the wh
#       command line, li

#           ksh Gra

#       Busybox and similar reduced shells will NOT work, because this scr
#       requires all of these POSIX shell featur
#         * functio
#         * expansions «$var», «${var}», «${var:-default}», «${var+SET
#           «${var#prefix}», «${var%suffix}», and «$( cmd 
#         * compound commands having a testable exit status, especially «cas
#         * various built-in commands including «command», «set», and «ulimi

#   Important for patchi

#   (2) This script targets any POSIX shell, so it avoids extensions provi
#       by Bash, Ksh, etc; in particular arrays are avoid

#       The "traditional" practice of packing multiple parameters int
#       space-separated string is a well documented source of bugs and secur
#       problems, so this is (mostly) avoided, by progressively accumulat
#       options in "$@", and eventually passing that to Ja

#       Where the inherited environment variables (DEFAULT_JVM_OPTS, JAVA_OP
#       and GRADLE_OPTS) rely on word-splitting, this is performed explicit
#       see the in-line comments for detai

#       There are tweaks for specific operating systems such as AIX, CygW
#       Darwin, MinGW, and NonSt

#   (3) This script is generated from the Groovy templ
#       https://github.com/gradle/gradle/blob/master/subprojects/plugins/src/main/resources/org/gradle/api/internal/plugins/unixStartScript.
#       within the Gradle proje

#       You can find Gradle at https://github.com/gradle/gradl

###########################################################################

# Attempt to set APP_H

# Resolve links: $0 may be a l
app_path

# Need this for daisy-chained symlin
wh
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; empty if no leading p
    [ -h "$app_path

    ls=$( ls -ld "$app_path
    link=${ls#*' ->
    case $link in            
      /*)   app_path=$link ;;
      *)    app_path=$APP_HOME$link
    e
d

APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || e

APP_NAME="Grad
APP_BASE_NAME=${0##

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this scri
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64

# Use the maximum available, or set MAX_FD != -1 to use that val
MAX_FD=maxi

warn (
    echo "
} 

die (
    e
    echo "
    e
    exi
} 

# OS specific support (must be 'true' or 'false
cygwin=fa
msys=fa
darwin=fa
nonstop=fa
case "$( uname )" in               
  CYGWIN* )         cygwin=true  ;;
  Darwin* )         darwin=true  ;;
  MSYS* | MINGW* )  msys=true    ;;
  NONSTOP* )        nonstop=true
e

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.


# Determine the Java command to use to start the J
if [ -n "$JAVA_HOME" ] ; t
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; t
        # IBM's JDK on AIX uses strange locations for the executab
        JAVACMD=$JAVA_HOME/jre/sh/j
    e
        JAVACMD=$JAVA_HOME/bin/j
   
    if [ ! -x "$JAVACMD" ] ; t
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_H

Please set the JAVA_HOME variable in your environment to match 
location of your Java installatio
   
e
    JAVACMD=j
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PA

Please set the JAVA_HOME variable in your environment to match 
location of your Java installatio


# Increase the maximum file descriptors if we c
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; t
    case $MAX_FD in
      ma
        MAX_FD=$( ulimit -H -n )
            warn "Could not query maximum file descriptor lim
    e
    case $MAX_FD in 
      '' | soft) :;;
     
        ulimit -n "$MAX_FD"
            warn "Could not set maximum file descriptor limit to $MAX_
    e


# Collect all arguments for the java command, stacking in reverse ord
#   * args from the command l
#   * the main class n
#   * -classp
#   * -D...appname setti
#   * --module-path (only if need
#   * DEFAULT_JVM_OPTS, JAVA_OPTS, and GRADLE_OPTS environment variabl

# For Cygwin or MSYS, switch paths to Windows format before running j
if "$cygwin" || "$msys" ; t
    APP_HOME=$( cygpath --path --mixed "$APP_HOME
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH

    JAVACMD=$( cygpath --unix "$JAVACMD

    # Now convert the arguments - kludge to limit ourselves to /bin
    for arg
       
            case $arg in                               
              -*)   false ;;                            # don't mess with options
              /?*)  t=${arg#/} t=/${t%%/*}              # looks like a POSIX filep
                    [ -e "$t" ] ;;                     
              *)    false
            e
        t
            arg=$( cygpath --path --ignore --mixed "$arg
       
        # Roll the args list around exactly as many times as the number
        # args, so each arg winds up back in the position where it started, 
        # possibly modifi
      
        # NB: a `for` loop captures its iteration list before it begins,
        # changing the positional parameters here affects neither the number
        # iterations, nor the values presented in `ar
        shift                   # remove old 
        set -- "$@" "$arg"      # push replacement 
    d


# Collect all arguments for the java comma
#   * $DEFAULT_JVM_OPTS, $JAVA_OPTS, and $GRADLE_OPTS can contain fragments
#     shell script including quotes and variable substitutions, so put them
#     double quotes to make sure that they get re-expanded; 
#   * put everything else in single quotes, so that it's not re-expand

set -
        "-Dorg.gradle.appname=$APP_BASE_NAME
        -classpath "$CLASSPATH
        org.gradle.wrapper.GradleWrapperMai
        "

# Use "xargs" to parse quoted ar

# With -n1 it outputs one arg per line, with the quotes and backslashes remov

# In Bash we could simply 

#   readarray ARGS < <( xargs -n1 <<<"$var" )
#   set -- "${ARGS[@]}" "

# but POSIX shell has neither arrays nor command substitution, so instead
# post-process each arg (as a line of input to sed) to backslash-escape 
# character that might be a shell metacharacter, then use eval to reve
# that process (while maintaining the separation between arguments), and w
# the whole thing up as a single "set" stateme

# This will of course break if any of these variables contains a newline
# an unmatched quo


eval "set --
        printf '%s\n' "$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS
        xargs -n
        sed ' s~[^-[:alnum:]+,./:=@_]~\\&~g; 
        tr '\n' 
    )" '"$

exec "$JAVACMD" "
